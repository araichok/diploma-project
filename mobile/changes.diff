+  List<List<double>> _simplifyPath(List<List<double>> path, {int step = 5}) {
+    if (path.length <= step) return path;
+    final result = <List<double>>[];
+    for (int i = 0; i < path.length; i++) {
+      if (i == 0 || i == path.length - 1 || i % step == 0) result.add(path[i]);
+    }
+    return result;
+  }
