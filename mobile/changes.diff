+          'type': 'polyline',
+          'linecolor': '#0066FF',
+          'linewidth': 3,
+          'lineopacity': 0.8,
+          'linestyle': 'solid',
+          'value': simplified
+              .map((pt) => {'lat': pt[1], 'lon': pt[0]})
+              .toList(),
+        }
+      ];
+    }
